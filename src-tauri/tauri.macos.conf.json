{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "Chladni",
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Chladni",
        "width": 1280,
        "height": 832,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 20, "y": 30 },
        "hiddenTitle": true
      }
    ]
  }
}
